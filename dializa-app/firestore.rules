rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function autenticado() { return request.auth != null; }
  function perfil() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
  function activo() {
   return autenticado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
    perfil().get('activo', false) == true && perfil().get('operacionCuenta', null) == null && perfil().get('bajaEnCurso', false) == false;
  }
  function esAdmin() { return activo() && perfil().rol == 'admin'; }
  function esConductor() { return activo() && perfil().rol == 'chofer' && perfil().get('aprobado', false) == true; }
  function esDueno(uid) { return activo() && request.auth.uid == uid; }
  function conductorDelPaciente(uid) {
   return esConductor() && exists(/databases/$(database)/documents/viajes/$(uid)) &&
    get(/databases/$(database)/documents/viajes/$(uid)).data.choferId == request.auth.uid &&
    get(/databases/$(database)/documents/viajes/$(uid)).data.get('estado', 'asignado') in ['asignado','conductor_en_camino','conductor_llego','en_viaje'];
  }
  match /usuarios/{uid} {
   // El propio perfil permite detectar desactivacion. No contiene tokens;
   // ejecutar migrar-privacidad antes del despliegue (ver docs).
   allow get: if (autenticado() && request.auth.uid == uid) || esAdmin() || conductorDelPaciente(uid);
   allow list: if esAdmin();
   allow write: if false;
  }
  match /usuarios_privado/{uid} { allow read, write: if false; }
  match /fcmTokens/{id} { allow read, write: if false; }
  match /fcmSesiones/{id} { allow read, write: if false; }
  match /choferes_privado/{uid} {
   allow read: if esDueno(uid) || esAdmin();
   allow write: if false;
  }
  match /viajes/{pacienteId} {
   allow read: if esAdmin() || esDueno(pacienteId) || (esConductor() && resource.data.choferId == request.auth.uid);
   allow write: if false;
  }
  match /solicitudes/{id} {
   allow read: if esAdmin() || (activo() && resource.data.pacienteId == request.auth.uid) ||
     (esConductor() && (resource.data.conductorId == request.auth.uid || resource.data.estado == 'solicitado'));
   allow write: if false;
  }
  match /respuestas_paciente/{uid} {
   allow read: if esAdmin() || esDueno(uid) || conductorDelPaciente(uid);
   allow write: if esAdmin() || (esDueno(uid) && perfil().rol == 'paciente');
  }
  match /historial_viajes/{id} { allow read: if esAdmin(); allow write: if false; }
  match /gps_viajes/{id} { allow read: if esAdmin(); allow write: if false; }
  match /gps_viajes/{id}/{resto=**} { allow read: if esAdmin(); allow write: if false; }
  match /auditoria/{id} { allow read: if esAdmin(); allow write: if false; }
  match /{document=**} { allow read, write: if false; }
 }
}
