{
  "name": "dializa-app-tests",
  "private": true,
  "description": "Herramientas de prueba de reglas (Emulator Suite). Las dependencias de las Cloud Functions viven en functions/package.json.",
  "scripts": {
    "test:functions": "npm --prefix functions test",
    "test:reglas:firestore": "firebase emulators:exec --only firestore --project demo-dializa-h10 \"mocha tests/firestore.rules.test.js --timeout 20000\"",
    "test:reglas:database": "firebase emulators:exec --only database --project demo-dializa-h10 \"mocha tests/database.rules.test.js --timeout 20000\"",
    "test:reglas": "npm run test:reglas:firestore && npm run test:reglas:database",
    "test:integracion": "firebase emulators:exec --only auth,firestore,database --project demo-dializa-h10 \"node --test integration/regresiones.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.14.1",
    "firebase-tools": "^13.29.1",
    "mocha": "^10.8.0"
  }
}
